[Unit]
Description=hop.rip URL shortener
After=network-online.target
Wants=network-online.target

[Service]
User=hop
Group=hop
EnvironmentFile=-/etc/hop/env
ExecStart=/usr/local/bin/hop serve
Restart=on-failure
LimitNOFILE=65536:524288
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/hop

[Install]
WantedBy=multi-user.target
